# Set these in the shell before initialization and Reflex startup.
# This example is documentation; it is not loaded automatically.
INTERSECT_DB_PATH=data/intersect.sqlite3
# Recommended: same-origin Reflex --single-port, with no API_URL setting.
# For separate development ports only:
# INTERSECT_API_URL=http://localhost:8000
# INTERSECT_ALLOWED_ORIGINS=http://localhost:3000
# For an HTTPS deployment behind a proxy:
# INTERSECT_SECURE_COOKIES=true
